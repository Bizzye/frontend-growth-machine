# Backend API base URL used by the browser (inlined at build time).
NEXT_PUBLIC_API_URL=http://localhost:3333/api

# Optional: backend URL used by the Next.js server (NextAuth). Defaults to NEXT_PUBLIC_API_URL.
# Useful when the server reaches the API through an internal hostname (e.g. Docker network).
# API_URL=http://backend:3333/api

# NextAuth — generate a secret with: npx auth secret  (or: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
